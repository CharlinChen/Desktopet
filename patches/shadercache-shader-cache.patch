+// Desktopet 扩展:着色器字节码磁盘缓存。
+// 缓存 key = profile + entryPoint + FNV-1a(着色器源码),源码一变自动失效。
+// 全部编译成功后写 sentinel 文件作为"缓存就绪"标记,供上层决定是否显示启动提示。
+
+const csmChar* s_cacheDir = NULL;  // 由上层传入,仅存指针(不拷贝)
+
+// FNV-1a 32 位哈希(着色器源码摘要,非密码学用途)
+csmUint32 Fnv1a(const void* data, csmSizeInt len)
+{
+    const csmByte* p = static_cast<const csmByte*>(data);
+    csmUint32 h = 2166136261u;
+    for (csmSizeInt i = 0; i < len; ++i)
+    {
+        h ^= p[i];
+        h *= 16777619u;
+    }
+    return h;
+}
+
+// UTF-8 → 宽字符(Windows API 需要)。缓存目录/exe 路径可能含非 ASCII。
+std::wstring ToWide(const char* s)
+{
+    if (!s || !s[0]) return L"";
+    const int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, nullptr, 0);
+    std::wstring w(static_cast<size_t>(n), L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, s, -1, &w[0], n);
+    return w;
+}
+
+// 拼接缓存文件完整路径(dir + profile_entrypoint_hash.cso),返回宽字符
+std::wstring CachePath(const csmChar* profile, const csmChar* entryPoint, csmUint32 hash)
+{
+    std::string p = s_cacheDir;
+    p += profile;
+    p += "_";
+    p += (entryPoint && entryPoint[0]) ? entryPoint : "entry";
+    char hex[16];
+    std::snprintf(hex, sizeof hex, "_%08x.cso", hash);
+    p += hex;
+    return ToWide(p.c_str());
+}
+
+const char* SentinelName = "complete.marker";
+
+}  // namespace
+
+void CubismShader_D3D11::SetCacheDirectory(const csmChar* dir)
+{
+    s_cacheDir = dir;
+}
+
+csmBool CubismShader_D3D11::IsCacheReady()
+{
+    if (!s_cacheDir) return false;
+    std::string marker = s_cacheDir;
+    marker += SentinelName;
+    const DWORD attr = GetFileAttributesW(ToWide(marker.c_str()).c_str());
+    return attr != INVALID_FILE_ATTRIBUTES;
+}
